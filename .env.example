# Sentry Data Source Name (DSN)
# Found in Sentry > Settings > Projects > [Project Name] > Client Keys
VITE_SENTRY_DSN=

# Force enable Sentry in development mode (true/false)
# Useful for testing crash reporting without building
VITE_ENABLE_SENTRY=false

# App Environment (development | production)
# VITE_APP_ENV=development